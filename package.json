{
  "name": "fort",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Fort: a creative freebuild sandbox delivered as an installable fullscreen PWA.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --port 4173",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "check:no-emdash": "node scripts/check-no-emdash.mjs",
    "check": "npm run typecheck && npm run lint && npm run check:no-emdash",
    "test:unit": "vitest run",
    "test": "playwright test",
    "test:verify": "playwright test tests/verify.spec.ts",
    "verify": "npm run check && npm run test:unit && npm run test"
  },
  "dependencies": {
    "three": "^0.169.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.48.0",
    "@types/node": "^22.20.0",
    "@types/three": "^0.169.0",
    "@typescript-eslint/eslint-plugin": "^8.8.0",
    "@typescript-eslint/parser": "^8.8.0",
    "eslint": "^8.57.1",
    "typescript": "^5.6.0",
    "vite": "^5.4.0",
    "vitest": "^2.1.0"
  }
}
